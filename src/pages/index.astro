---
import BaseLayout from "@layouts/BaseLayout.astro";
import HeroUnboxing from "@components/HeroUnboxing.astro";
import PremiumCollection from "@components/PremiumCollection.astro";
import QueenFlow from "@components/QueenFlow.astro";
import { site } from "@data/site";
import { withBase } from "@utils/paths";

const highlights = [
  {
    theme: "highlight-slide-dark",
    eyebrow: "Queen Seçkisi",
    title: "Bir kutu. Birçok güçlü iz.",
    text: "Yeni çalışanlardan iş ortaklarına kadar her karşılaşmayı özenli bir marka deneyimine dönüştüren setler.",
    href: "/kategoriler/hediyelik-setler",
    images: [
      { src: "/assets/images/queen-edit-hediyelik-set-queen.webp", alt: "Queen logolu kutulu kurumsal hediye seti" },
      { src: "/assets/images/queen-edit-defter-ajanda-queen.webp", alt: "Queen sıcak yaldız uygulamalı deri defter" },
      { src: "/assets/images/queen-edit-matara-queen.webp", alt: "Queen logolu pembe ve şeffaf matara" },
    ],
  },
  {
    theme: "highlight-slide-gold",
    eyebrow: "Baskı & Üretim",
    title: "Detayda tutarlı. Elde etkileyici.",
    text: "Renk, malzeme ve baskı tekniğini aynı sistemde buluşturan kurumsal üretim yaklaşımı.",
    href: "/baski-ve-uretim-sureci",
    image: { src: "/assets/catalog/queen-corporate-stationery-suite.webp", alt: "Queen logolu kurumsal kimlik ve baskı seti" },
  },
  {
    theme: "highlight-slide-blue",
    eyebrow: "Teknoloji",
    title: "Günlük hayatın içinde. Markanızla birlikte.",
    text: "Powerbank, USB ve bağlantı ürünlerinde kullanışlı, modern ve baskıya hazır çözümler.",
    href: "/kategoriler/powerbank",
    image: { src: "/assets/piili/piili-mag-ring-powerbank-pb8.png", alt: "Piili Mag Ring Stand kablosuz powerbank" },
  },
  {
    theme: "highlight-slide-light",
    eyebrow: "Kurumsal Tekstil",
    title: "Ekibiniz için tek ve güçlü bir görünüm.",
    text: "Etkinlik, saha ve ofis ekipleri için baskı ve nakış seçenekleriyle tamamlanan tekstil seçkisi.",
    href: "/kategoriler/tekstil",
    image: { src: "/assets/images/queen-edit-tekstil-queen.webp", alt: "Queen nakış uygulamalı kurumsal sweatshirt ve şapka" },
  },
];

const promoTiles = [
  {
    className: "promo-tile-light",
    eyebrow: "Defter & Ajanda",
    title: "Her fikre iyi bir başlangıç.",
    text: "Kurumsal not alma deneyimi, markanıza özel.",
    href: "/kategoriler/defter-ajanda",
    image: "/assets/images/queen-edit-defter-ajanda-queen.webp",
    alt: "Queen uygulamalı premium defter ve kalem seçkisi",
  },
  {
    className: "promo-tile-dark",
    eyebrow: "Hediyelik Setler",
    title: "Açıldığında Queen etkisi.",
    text: "Üründen kutuya, markanıza özel tek bir deneyim.",
    href: "/kategoriler/hediyelik-setler",
    image: "/assets/images/queen-edit-hediyelik-set-queen.webp",
    alt: "Queen logolu premium kurumsal hediye kutusu",
  },
  {
    className: "promo-tile-image",
    eyebrow: "Tekstil",
    title: "Ekibiniz. Tek bir görünüm.",
    text: "Baskı ve nakış seçenekleriyle kurumsal tekstil.",
    href: "/kategoriler/tekstil",
    image: "/assets/images/queen-edit-tekstil-queen.webp",
    alt: "Queen nakışlı sweatshirt ve şapka",
  },
  {
    className: "promo-tile-blush",
    eyebrow: "Termos & Matara",
    title: "Renginizle hatırlanın.",
    text: "Günlük kullanıma Queen dokunuşu.",
    href: "/kategoriler/termos-matara",
    image: "/assets/images/queen-edit-matara-queen.webp",
    alt: "Queen logolu pembe ve şeffaf kurumsal matara",
  },
];

const homeSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  url: site.url,
  potentialAction: {
    "@type": "SearchAction",
    target: `${site.url}/kategoriler?search={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
};
---

<BaseLayout
  title="Kurumsal Promosyon Ürünleri"
  description="Queen Promosyon; logolu promosyon ürünleri, kurumsal hediye setleri, baskılı tekstil ve teknoloji ürünleri için katalog ve teklif çözümleri sunar."
  structuredData={homeSchema}
>
  <div class="shop-ribbon">
    <p>Türkiye’nin her yerine kurumsal üretim ve teslimat. <a href={withBase("/baski-ve-uretim-sureci")}>Süreci inceleyin <span>›</span></a></p>
  </div>

  <div class="apple-home">
    <HeroUnboxing />

    <section class="apple-hero apple-hero-bottle" aria-labelledby="bottle-title">
      <div class="bottle-story-shell">
        <div class="apple-hero-copy apple-hero-copy-dark" data-reveal="copy">
          <span>Termos & Matara</span>
          <h2 id="bottle-title">Her gün görünür.<br />Her yudumda hatırlanır.</h2>
          <p>Queen baskısıyla tamamlanan, gerçekten kullanılmak için seçilmiş modeller.</p>
          <div class="apple-actions">
            <a class="apple-button" href={withBase("/kategoriler/termos-matara")}>Daha fazla bilgi</a>
            <a class="apple-button apple-button-outline" href={withBase("/teklif-al")}>Teklif alın</a>
          </div>
        </div>
        <figure class="bottle-product-visual" data-reveal="media">
          <img src={withBase("/assets/images/queen-edit-matara-queen.webp")} alt="Queen sıcak yaldız logolu pembe ve şeffaf matara" loading="lazy" width="1440" height="1080" />
        </figure>
      </div>
    </section>

    <section class="apple-hero apple-hero-tech" aria-labelledby="tech-title">
      <div class="tech-story-shell">
        <div class="apple-hero-copy apple-hero-copy-dark" data-reveal="copy">
          <span>Piili ile Teknoloji</span>
          <h2 id="tech-title">Gücünüz yanınızda.<br />Markanız akılda.</h2>
          <p>Standlı MagSafe powerbank ile masada, toplantıda ve yolculukta kesintisiz güç.</p>
          <div class="apple-actions">
            <a class="apple-button" href={withBase("/kategoriler/powerbank")}>Ürünleri keşfedin</a>
            <a class="apple-button apple-button-outline" href={withBase("/teklif-al")}>Teklif alın</a>
          </div>
        </div>
        <figure class="tech-product-visual" data-reveal="media">
          <div class="tech-energy-ring" aria-hidden="true"></div>
          <!-- Official product visual: https://www.piili.com/urun/mag-ring-stand-10-000-mah-p-pb8-powerbank-gri/ -->
          <img data-parallax src={withBase("/assets/piili/piili-mag-ring-powerbank-pb8.png")} alt="Piili Mag Ring Stand kablosuz powerbank" loading="lazy" width="1200" height="1200" />
        </figure>
      </div>
    </section>

    <PremiumCollection />

    <section class="apple-highlights" data-highlights aria-labelledby="highlights-title">
      <div class="apple-highlights-heading" data-reveal="heading">
        <h2 id="highlights-title">İşte öne çıkanlar. <span>Queen dünyasından dört başlık.</span></h2>
      </div>

      <div class="highlight-track" data-highlight-track tabindex="0" aria-label="Öne çıkan Queen çözümleri">
        {highlights.map((highlight, index) => (
          <article class={`highlight-slide ${highlight.theme}`} data-highlight-slide aria-label={`${index + 1} / ${highlights.length}: ${highlight.title}`}>
            <div class="highlight-copy">
              <span>{highlight.eyebrow}</span>
              <h3>{highlight.title}</h3>
              <p>{highlight.text}</p>
              <a href={withBase(highlight.href)}>Daha fazla bilgi <span aria-hidden="true">›</span></a>
            </div>

            {highlight.images ? (
              <div class="highlight-triptych" aria-hidden="true">
                {highlight.images.map((image) => (
                  <figure><img src={withBase(image.src)} alt={image.alt} loading="lazy" width="900" height="900" /></figure>
                ))}
              </div>
            ) : highlight.image ? (
              <figure class="highlight-visual">
                <img src={withBase(highlight.image.src)} alt={highlight.image.alt} loading="lazy" width="1800" height="1200" />
              </figure>
            ) : null}
          </article>
        ))}
      </div>

      <div class="highlight-controls" aria-label="Öne çıkanlar kontrolleri">
        <div class="highlight-pagination">
          {highlights.map((highlight, index) => (
            <button type="button" data-highlight-dot aria-label={`${index + 1}. başlığa git: ${highlight.title}`} aria-current={index === 0 ? "true" : "false"}><span></span></button>
          ))}
        </div>
        <button class="highlight-toggle" type="button" data-highlight-toggle aria-pressed="false">Duraklat</button>
      </div>
      <span class="sr-only" data-highlight-status aria-live="polite"></span>
    </section>

    <section class="apple-promo-grid" aria-label="Öne çıkan Queen koleksiyonları">
      {promoTiles.map((tile) => (
        <article class={`apple-promo-tile ${tile.className}`} data-reveal>
          <img src={withBase(tile.image)} alt={tile.alt} loading="lazy" width="1800" height="1350" />
          <div>
            <span>{tile.eyebrow}</span>
            <h2>{tile.title}</h2>
            <p>{tile.text}</p>
            <div class="apple-tile-actions">
              <a class="apple-button apple-button-small" href={withBase(tile.href)}>Daha fazla bilgi</a>
              <a class="apple-round-link" href={withBase("/teklif-al")} aria-label={`${tile.eyebrow} için teklif alın`}>+</a>
            </div>
          </div>
        </article>
      ))}
    </section>

    <QueenFlow />

    <section class="apple-final-cta" data-reveal>
      <div>
        <span>Queen for Business</span>
        <h2>Bir sonraki projenizi<br />birlikte tasarlayalım.</h2>
        <p>Ürünü, adedi ve teslim tarihini paylaşın. En doğru çözümü hazırlayalım.</p>
        <a class="apple-button" href={withBase("/teklif-al")}>Teklif alın</a>
      </div>
    </section>
  </div>
</BaseLayout>
