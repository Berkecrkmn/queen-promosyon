---
import BaseLayout from "@layouts/BaseLayout.astro";
import { categories } from "@data/catalog";
import { site } from "@data/site";
import { withBase } from "@utils/paths";

const categoryRail = categories.slice(0, 10);

const highlights = [
  {
    theme: "highlight-slide-dark",
    eyebrow: "Queen Seçkisi",
    title: "Bir kutu. Birçok güçlü iz.",
    text: "Yeni çalışanlardan iş ortaklarına kadar her karşılaşmayı özenli bir marka deneyimine dönüştüren setler.",
    href: "/kategoriler/hediyelik-setler",
    images: [
      { src: "/assets/images/queen-promosyon-premium-kutulu-hediye-seti.webp", alt: "Premium kutulu kurumsal hediye seti" },
      { src: "/assets/images/queen-promosyon-termo-deri-defter-urun.webp", alt: "Termo deri kurumsal defter" },
      { src: "/assets/images/queen-promosyon-celik-termos-500ml.webp", alt: "Logo baskıya uygun çelik termos" },
    ],
  },
  {
    theme: "highlight-slide-gold",
    eyebrow: "Baskı & Üretim",
    title: "Detayda tutarlı. Elde etkileyici.",
    text: "Renk, malzeme ve baskı tekniğini aynı sistemde buluşturan kurumsal üretim yaklaşımı.",
    href: "/baski-ve-uretim-sureci",
    image: { src: "/assets/images/queen-promosyon-kurumsal-kimlik-baski-seti.webp", alt: "Kurumsal kimlik ve baskı uygulama seti" },
  },
  {
    theme: "highlight-slide-blue",
    eyebrow: "Teknoloji",
    title: "Günlük hayatın içinde. Markanızla birlikte.",
    text: "Powerbank, USB ve bağlantı ürünlerinde kullanışlı, modern ve baskıya hazır çözümler.",
    href: "/kategoriler/powerbank",
    image: { src: "/assets/images/queen-promosyon-teknoloji-hediye-seti.webp", alt: "Kurumsal teknoloji hediye seti" },
  },
  {
    theme: "highlight-slide-light",
    eyebrow: "Kurumsal Tekstil",
    title: "Ekibiniz için tek ve güçlü bir görünüm.",
    text: "Etkinlik, saha ve ofis ekipleri için baskı ve nakış seçenekleriyle tamamlanan tekstil seçkisi.",
    href: "/kategoriler/tekstil",
    image: { src: "/assets/images/queen-promosyon-nakisli-sweatshirt.webp", alt: "Nakış uygulamalı kurumsal sweatshirt" },
  },
];

const promoTiles = [
  {
    className: "promo-tile-light",
    eyebrow: "Defter & Ajanda",
    title: "Her fikre iyi bir başlangıç.",
    text: "Kurumsal not alma deneyimi, markanıza özel.",
    href: "/kategoriler/defter-ajanda",
    image: "/assets/images/queen-apple-desk.webp",
    alt: "Minimal çalışma masasında defter, kalem ve ofis ürünleri",
  },
  {
    className: "promo-tile-dark",
    eyebrow: "Çanta",
    title: "Markanız her yerde sizinle.",
    text: "Günlük kullanıma uygun, baskıya hazır çanta seçkisi.",
    href: "/kategoriler/canta",
    image: "/assets/images/queen-apple-tote.webp",
    alt: "Minimal bir ortamda taşınan premium kanvas çanta",
  },
  {
    className: "promo-tile-image",
    eyebrow: "Tekstil",
    title: "Ekibiniz. Tek bir görünüm.",
    text: "Baskı ve nakış seçenekleriyle kurumsal tekstil.",
    href: "/kategoriler/tekstil",
    image: "/assets/images/queen-promosyon-nakisli-sweatshirt.webp",
    alt: "Farklı renklerde kurumsal tekstil ürünleri",
  },
  {
    className: "promo-tile-paper",
    eyebrow: "Matbaa Ürünleri",
    title: "İyi tasarım, elde de etkileyici.",
    text: "Kartvizitten kataloğa eksiksiz kurumsal baskı.",
    href: "/kategoriler/matbaa-urunleri",
    image: "/assets/images/queen-promosyon-katalog-baski.webp",
    alt: "Kurumsal kimlik ve matbaa baskı seti",
  },
];

const homeSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  url: site.url,
  potentialAction: {
    "@type": "SearchAction",
    target: `${site.url}/kategoriler?search={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
};
---

<BaseLayout
  title="Kurumsal Promosyon Ürünleri"
  description="Queen Promosyon; logolu promosyon ürünleri, kurumsal hediye setleri, baskılı tekstil ve teknoloji ürünleri için katalog ve teklif çözümleri sunar."
  structuredData={homeSchema}
>
  <div class="shop-ribbon">
    <p>Türkiye’nin her yerine kurumsal üretim ve teslimat. <a href={withBase("/baski-ve-uretim-sureci")}>Süreci inceleyin <span>›</span></a></p>
  </div>

  <div class="apple-home">
    <section class="apple-hero apple-hero-workspace" aria-labelledby="hero-title">
      <div class="hero-product-shell">
        <div class="apple-hero-copy apple-hero-copy-dark" data-reveal="copy">
          <span>Queen Promosyon</span>
          <h1 id="hero-title">Markanızın.<br />En iyi hali.</h1>
          <p>İnsanların gerçekten kullanmak isteyeceği kurumsal ürünler.</p>
          <div class="apple-actions">
            <a class="apple-button" href={withBase("/kategoriler")}>Koleksiyonu keşfedin</a>
            <a class="apple-button apple-button-outline" href={withBase("/teklif-al")}>Teklif alın</a>
          </div>
        </div>
        <figure class="hero-product-visual" data-reveal="media">
          <img data-parallax src={withBase("/assets/images/queen-home-hero-stationery.webp")} alt="Açık renkli çalışma masasında defter ve kalem seçkisi" width="2400" height="3600" />
        </figure>
      </div>
    </section>

    <section class="apple-hero apple-hero-bottle" aria-labelledby="bottle-title">
      <div class="apple-hero-copy apple-hero-copy-dark" data-reveal="copy">
        <span>Termos & Matara</span>
        <h2 id="bottle-title">Her gün görünür.<br />Her yudumda hatırlanır.</h2>
        <p>Uzun ömürlü kullanım için seçilen premium modeller.</p>
        <div class="apple-actions">
          <a class="apple-button" href={withBase("/kategoriler/termos-matara")}>Daha fazla bilgi</a>
          <a class="apple-button apple-button-outline" href={withBase("/teklif-al")}>Teklif alın</a>
        </div>
      </div>
      <img data-parallax src={withBase("/assets/images/queen-apple-bottle.webp")} alt="Yeşil tonlu çelik matara" loading="lazy" width="1800" height="2700" />
    </section>

    <section class="apple-hero apple-hero-tech" aria-labelledby="tech-title">
      <div class="tech-story-shell">
        <div class="apple-hero-copy apple-hero-copy-dark" data-reveal="copy">
          <span>Teknoloji Ürünleri</span>
          <h2 id="tech-title">Gücünüz yanınızda.<br />Markanız akılda.</h2>
          <p>Powerbank, USB ve günlük kullanıma hazır şarj çözümleri.</p>
          <div class="apple-actions">
            <a class="apple-button" href={withBase("/kategoriler/powerbank")}>Ürünleri keşfedin</a>
            <a class="apple-button apple-button-outline" href={withBase("/teklif-al")}>Teklif alın</a>
          </div>
        </div>
        <figure class="tech-product-visual" data-reveal="media">
          <img data-parallax src={withBase("/assets/images/queen-home-tech-powerbank.webp")} alt="Beyaz powerbank ve mavi çoklu şarj kabloları" loading="lazy" width="2400" height="1600" />
        </figure>
      </div>
    </section>

    <section class="category-showcase" aria-labelledby="category-title">
      <div class="category-showcase-heading" data-reveal="heading">
        <h2 id="category-title">Tüm ürünler. <span>Markanız için en iyisini seçin.</span></h2>
        <a href={withBase("/kategoriler")}>Tüm kategorileri görün <span>›</span></a>
      </div>
      <div class="category-rail" data-reveal="rail">
        {categoryRail.map((category) => (
          <a href={withBase(`/kategoriler/${category.slug}`)}>
            <figure>
              <img src={withBase(category.image)} alt={category.alt} loading="lazy" width="320" height="240" />
            </figure>
            <strong>{category.title}</strong>
            <span>{category.eyebrow}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="apple-highlights" data-highlights aria-labelledby="highlights-title">
      <div class="apple-highlights-heading" data-reveal="heading">
        <h2 id="highlights-title">İşte öne çıkanlar. <span>Queen dünyasından dört başlık.</span></h2>
      </div>

      <div class="highlight-track" data-highlight-track tabindex="0" aria-label="Öne çıkan Queen çözümleri">
        {highlights.map((highlight, index) => (
          <article class={`highlight-slide ${highlight.theme}`} data-highlight-slide aria-label={`${index + 1} / ${highlights.length}: ${highlight.title}`}>
            <div class="highlight-copy">
              <span>{highlight.eyebrow}</span>
              <h3>{highlight.title}</h3>
              <p>{highlight.text}</p>
              <a href={withBase(highlight.href)}>Daha fazla bilgi <span aria-hidden="true">›</span></a>
            </div>

            {highlight.images ? (
              <div class="highlight-triptych" aria-hidden="true">
                {highlight.images.map((image) => (
                  <figure><img src={withBase(image.src)} alt={image.alt} loading="lazy" width="900" height="900" /></figure>
                ))}
              </div>
            ) : highlight.image ? (
              <figure class="highlight-visual">
                <img src={withBase(highlight.image.src)} alt={highlight.image.alt} loading="lazy" width="1800" height="1200" />
              </figure>
            ) : null}
          </article>
        ))}
      </div>

      <div class="highlight-controls" aria-label="Öne çıkanlar kontrolleri">
        <div class="highlight-pagination">
          {highlights.map((highlight, index) => (
            <button type="button" data-highlight-dot aria-label={`${index + 1}. başlığa git: ${highlight.title}`} aria-current={index === 0 ? "true" : "false"}><span></span></button>
          ))}
        </div>
        <button class="highlight-toggle" type="button" data-highlight-toggle aria-pressed="false">Duraklat</button>
      </div>
      <span class="sr-only" data-highlight-status aria-live="polite"></span>
    </section>

    <section class="apple-promo-grid" aria-label="Öne çıkan Queen koleksiyonları">
      {promoTiles.map((tile) => (
        <article class={`apple-promo-tile ${tile.className}`} data-reveal>
          <img src={withBase(tile.image)} alt={tile.alt} loading="lazy" width="1800" height="1350" />
          <div>
            <span>{tile.eyebrow}</span>
            <h2>{tile.title}</h2>
            <p>{tile.text}</p>
            <div class="apple-tile-actions">
              <a class="apple-button apple-button-small" href={withBase(tile.href)}>Daha fazla bilgi</a>
              <a class="apple-round-link" href={withBase("/teklif-al")} aria-label={`${tile.eyebrow} için teklif alın`}>+</a>
            </div>
          </div>
        </article>
      ))}
    </section>

    <section class="apple-services" aria-labelledby="services-title">
      <div class="apple-services-heading" data-reveal="heading">
        <h2 id="services-title">Queen farkı. <span>Kurumsal siparişin her adımında.</span></h2>
      </div>
      <div class="apple-service-grid">
        <article data-reveal>
          <span class="service-index" aria-hidden="true">01</span>
          <h3>Size özel ürün seçimi.</h3>
          <p>Hedef kitlenize, bütçenize ve kullanım senaryonuza uygun ürünleri birlikte belirleyin.</p>
          <a href={withBase("/kategoriler")} aria-label="Ürün seçimi hakkında daha fazla bilgi">+</a>
        </article>
        <article data-reveal>
          <span class="service-index" aria-hidden="true">02</span>
          <h3>Markanıza uygun baskı.</h3>
          <p>Lazer, serigrafi, UV ve tekstil uygulamalarında ürüne en uygun üretim tekniği.</p>
          <a href={withBase("/baski-ve-uretim-sureci")} aria-label="Baskı seçenekleri hakkında daha fazla bilgi">+</a>
        </article>
        <article data-reveal>
          <span class="service-index" aria-hidden="true">03</span>
          <h3>Türkiye geneli teslimat.</h3>
          <p>Üretim, kalite kontrol, paketleme ve sevkiyat tek bir akışta takip edilir.</p>
          <a href={withBase("/iletisim")} aria-label="Teslimat hakkında daha fazla bilgi">+</a>
        </article>
        <article data-reveal>
          <span class="service-index" aria-hidden="true">04</span>
          <h3>Teklif boyunca destek.</h3>
          <p>Ürün seçiminizden teslimata kadar Queen ekibiyle doğrudan iletişim kurun.</p>
          <a href={withBase("/teklif-al")} aria-label="Teklif desteği hakkında daha fazla bilgi">+</a>
        </article>
      </div>
    </section>

    <section class="apple-final-cta" data-reveal>
      <div>
        <span>Queen for Business</span>
        <h2>Bir sonraki projenizi<br />birlikte tasarlayalım.</h2>
        <p>Ürünü, adedi ve teslim tarihini paylaşın. En doğru çözümü hazırlayalım.</p>
        <a class="apple-button" href={withBase("/teklif-al")}>Teklif alın</a>
      </div>
    </section>
  </div>
</BaseLayout>
