---
import { navItems, site } from "@data/site";
import { categories, products } from "@data/catalog";

const quickCategories = categories.slice(0, 8);
const popularProducts = products.filter((product) => product.popular).slice(0, 4);
const primaryNavItems = navItems.filter((item) => item.label !== "Teklif Al");
const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="site-header">
  <a class="skip-link" href="#icerik">İçeriğe geç</a>
  <div class="header-shell">
    <a class="brand" href="/" aria-label={`${site.name} anasayfa`}>
      <img src="/assets/brand/queen-logo-transparent.png" alt="Queen Promosyon logo" width="92" height="92" />
    </a>

    <button class="menu-button" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-nav">
      <span></span>
      <span></span>
      <span></span>
      <span class="sr-only">Menüyü aç veya kapat</span>
    </button>

    <nav id="site-nav" class="site-nav" data-nav-panel aria-label="Ana menü">
      {primaryNavItems.map((item) => (
        item.label === "Kategoriler" ? (
          <div class="nav-group">
            <a class:list={["nav-link", { "is-active": isActive(item.href) }]} href={item.href}>Kategoriler</a>
            <div class="mega-menu" aria-label="Kategori hızlı erişim">
              <div class="mega-visual">
                <img src="/assets/images/queen-promosyon-header-kurumsal-vitrin.webp" alt="Queen Promosyon kurumsal hediye seti vitrini" width="360" height="300" loading="lazy" />
                <span>Yeni sezon seçkisi</span>
              </div>
              <div class="mega-copy">
                <span>Koleksiyon</span>
                <strong>Kurumsal hediye ve promosyon seçkisi</strong>
                <p>Markanıza uygun ürün gruplarını kullanım amacı, baskı tekniği ve sunum algısına göre keşfedin.</p>
                <a href="/urunler">Ürün seçkisini gör</a>
              </div>
              <div class="mega-list">
                {quickCategories.map((category) => (
                  <a href={`/kategoriler/${category.slug}`}>
                    <span>{category.eyebrow}</span>
                    <strong>{category.title}</strong>
                  </a>
                ))}
              </div>
              <div class="mega-products">
                <span>Çok talep edilenler</span>
                {popularProducts.map((product) => (
                  <a href={`/urunler/${product.slug}`}>{product.name}</a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a class:list={["nav-link", { "is-active": isActive(item.href) }]} href={item.href}>{item.label}</a>
        )
      ))}
    </nav>

    <div class="header-actions">
      <a class="header-mail" href={`mailto:${site.email}`}>{site.email}</a>
      <a class:list={["header-cta", { "is-active": isActive("/teklif-al") }]} href="/teklif-al">Teklif iste</a>
    </div>
  </div>
</header>
