---
import { navItems } from "@data/site";
import { categories } from "@data/catalog";
import { stripBase, withBase } from "@utils/paths";

const primaryNavItems = navItems.filter((item) => item.label !== "Teklif Al");
const quickCategories = categories.slice(0, 8);
const currentPath = stripBase(Astro.url.pathname);
const isActive = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="site-header">
  <a class="skip-link" href="#icerik">İçeriğe geç</a>
  <div class="header-shell">
    <a class="brand" href={withBase("/")} aria-label="Queen Promosyon anasayfa">
      <img class="brand-wordmark" src={withBase("/assets/brand/queen-wordmark-header.png")} alt="" width="856" height="298" />
      <span class="sr-only">Queen Promosyon</span>
    </a>

    <nav id="site-nav" class="site-nav" data-nav-panel aria-label="Ana menü">
      {primaryNavItems.map((item) => (
        item.label === "Kategoriler" ? (
          <div class="nav-group">
            <a class:list={["nav-link", { "is-active": isActive(item.href) }]} href={withBase(item.href)}>Kategoriler</a>
            <div class="mega-menu" aria-label="Kategori hızlı erişim">
              <div class="mega-copy">
                <span>Keşfedin</span>
                <strong>Ürün Kategorileri</strong>
                <a href={withBase("/kategoriler")}>Tüm kategorileri görün</a>
                <a href={withBase("/urunler")}>Tüm ürünleri görün</a>
                <a href={withBase("/teklif-al")}>Teklif alın</a>
              </div>
              <div class="mega-list">
                <span>Kategoriler</span>
                {quickCategories.map((category) => (
                  <a href={withBase(`/kategoriler/${category.slug}`)}>{category.title}</a>
                ))}
              </div>
              <div class="mega-products">
                <span>Queen ile alışveriş</span>
                <a href={withBase("/baski-ve-uretim-sureci")}>Baskı ve üretim</a>
                <a href={withBase("/kurumsal")}>Kurumsal çözümler</a>
                <a href={withBase("/iletisim")}>Uzman desteği</a>
              </div>
            </div>
          </div>
        ) : (
          <a class:list={["nav-link", { "is-active": isActive(item.href) }]} href={withBase(item.href)}>{item.label}</a>
        )
      ))}
      <a class:list={["nav-mobile-cta", { "is-active": isActive("/teklif-al") }]} href={withBase("/teklif-al")}>Teklif Al</a>
    </nav>

    <a class:list={["header-cta", { "is-active": isActive("/teklif-al") }]} href={withBase("/teklif-al")}>Teklif Al</a>

    <button class="menu-button" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-nav">
      <span></span>
      <span></span>
      <span class="sr-only">Menüyü aç veya kapat</span>
    </button>
  </div>
</header>
