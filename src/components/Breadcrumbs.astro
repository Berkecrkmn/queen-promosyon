---
import { withBase } from "@utils/paths";

type Crumb = {
  label: string;
  href?: string;
};

type Props = {
  items: Crumb[];
};

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href={withBase("/")}>Anasayfa</a></li>
    {items.map((item) => (
      <li>
        {item.href ? <a href={withBase(item.href)}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
      </li>
    ))}
  </ol>
</nav>
