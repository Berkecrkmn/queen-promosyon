---
import { withBase } from "@utils/paths";
---

<section class="apple-hero hero-unboxing" data-hero-unboxing aria-labelledby="hero-unboxing-title">
  <div class="unboxing-atmosphere" aria-hidden="true">
    <span class="unboxing-horizon"></span>
  </div>

  <div class="unboxing-shell">
    <header class="unboxing-copy">
      <span class="unboxing-eyebrow">Queen Promosyon</span>
      <h1 id="hero-unboxing-title">Markanız.<br /><em>Sahneye çıksın.</em></h1>
      <p>Ürünü, uygulamayı ve sunumu insanların gerçekten kullanmak isteyeceği tek bir deneyimde buluşturuyoruz.</p>
      <div class="apple-actions unboxing-actions">
        <a class="apple-button unboxing-primary" href={withBase("/kategoriler")}>Koleksiyonu keşfedin</a>
        <a class="unboxing-link" href={withBase("/teklif-al")}>Birlikte tasarlayalım <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <div
      class="unboxing-scene"
      data-unboxing-scene
      role="img"
      aria-label="Queen logolu defter, hediye kutusu ve mataradan oluşan hareketli ürün sahnesi"
    >
      <span class="unboxing-floor" aria-hidden="true"></span>

      <div class="unboxing-object unboxing-box" aria-hidden="true">
        <span>
          <img
            src={withBase("/assets/generated/queen-box-cutout.png")}
            alt=""
            width="1024"
            height="768"
            loading="eager"
            fetchpriority="high"
          />
        </span>
      </div>

      <div class="unboxing-object unboxing-notebooks" aria-hidden="true">
        <span>
          <img
            src={withBase("/assets/generated/queen-notebook-cutout.png")}
            alt=""
            width="1024"
            height="768"
            loading="eager"
          />
        </span>
      </div>

      <div class="unboxing-object unboxing-bottle" aria-hidden="true">
        <span>
          <img
            src={withBase("/assets/generated/queen-bottle-cutout.png")}
            alt=""
            width="1024"
            height="768"
            loading="eager"
          />
        </span>
      </div>

    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-hero-unboxing]").forEach((section) => {
    const scene = section.querySelector<HTMLElement>("[data-unboxing-scene]");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const precisePointer = window.matchMedia("(pointer: fine)");
    let pointerFrame = 0;
    let scrollFrame = 0;

    if (!scene) return;

    const renderScroll = () => {
      scrollFrame = 0;
      if (reduceMotion.matches) return;
      const rect = section.getBoundingClientRect();
      const progress = Math.min(1, Math.max(0, -rect.top / Math.max(1, rect.height * 0.8)));
      section.style.setProperty("--scene-scroll", `${(-progress * 24).toFixed(2)}px`);
      section.style.setProperty("--copy-scroll", `${(-progress * 18).toFixed(2)}px`);
      section.style.setProperty("--hero-fade", Math.max(0, 1 - progress * 1.6).toFixed(3));
    };

    window.addEventListener("scroll", () => {
      if (!scrollFrame) scrollFrame = requestAnimationFrame(renderScroll);
    }, { passive: true });
    renderScroll();

    if (precisePointer.matches && !reduceMotion.matches) {
      section.addEventListener("pointermove", (event) => {
        if (pointerFrame) return;
        pointerFrame = requestAnimationFrame(() => {
          pointerFrame = 0;
          const rect = section.getBoundingClientRect();
          const x = (event.clientX - rect.left) / rect.width - 0.5;
          const y = (event.clientY - rect.top) / rect.height - 0.5;
          scene.style.setProperty("--scene-ry", `${(x * 4.6).toFixed(2)}deg`);
          scene.style.setProperty("--scene-rx", `${(y * -3.2).toFixed(2)}deg`);
          scene.style.setProperty("--scene-x", `${(x * 11).toFixed(2)}px`);
          scene.style.setProperty("--scene-y", `${(y * 8).toFixed(2)}px`);
        });
      });

      section.addEventListener("pointerleave", () => {
        scene.style.setProperty("--scene-ry", "0deg");
        scene.style.setProperty("--scene-rx", "0deg");
        scene.style.setProperty("--scene-x", "0px");
        scene.style.setProperty("--scene-y", "0px");
      });
    }
  });
</script>

<style>
  .hero-unboxing {
    --scene-scroll: 0px;
    --copy-scroll: 0px;
    --hero-fade: 1;
    min-height: clamp(680px, calc(100svh - 98px), 940px);
    align-items: stretch;
    color: #1b1917;
    background:
      radial-gradient(ellipse at 78% 28%, rgba(255, 255, 255, 0.82) 0%, rgba(255, 255, 255, 0.34) 30%, transparent 58%),
      linear-gradient(180deg, #fbfaf8 0%, #eee9e2 64%, #ddd5ca 100%);
  }

  .hero-unboxing::before {
    content: "";
    position: absolute;
    z-index: 0;
    inset: 0;
    pointer-events: none;
    opacity: 0.4;
    background-image: radial-gradient(rgba(79, 62, 44, 0.2) 0.5px, transparent 0.5px);
    background-size: 7px 7px;
    mask-image: linear-gradient(90deg, transparent, #000 52%, transparent);
  }

  .unboxing-atmosphere {
    position: absolute;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .unboxing-horizon {
    position: absolute;
    right: 2%;
    bottom: 20%;
    width: 66%;
    height: 1px;
    opacity: 0;
    background: linear-gradient(90deg, transparent, rgba(113, 95, 77, 0.32), transparent);
    animation: unboxing-horizon 1.2s 1.2s ease forwards;
  }

  .unboxing-shell {
    position: relative;
    z-index: 2;
    width: min(1500px, calc(100% - 88px));
    min-height: inherit;
    margin: 0 auto;
  }

  .unboxing-copy {
    position: absolute;
    z-index: 10;
    left: 0;
    top: 48%;
    width: min(565px, 40vw);
    opacity: var(--hero-fade);
    transform: translate3d(0, calc(-50% + var(--copy-scroll)), 0);
  }

  .unboxing-copy > * {
    opacity: 0;
    transform: translateY(26px);
    animation: unboxing-copy-in 820ms cubic-bezier(0.16, 0.84, 0, 1) forwards;
  }

  .unboxing-copy > :nth-child(1) { animation-delay: 950ms; }
  .unboxing-copy > :nth-child(2) { animation-delay: 1.04s; }
  .unboxing-copy > :nth-child(3) { animation-delay: 1.16s; }
  .unboxing-copy > :nth-child(4) { animation-delay: 1.28s; }

  .unboxing-eyebrow {
    display: flex;
    align-items: center;
    gap: 13px;
    margin-bottom: 21px;
    color: #8f5c35;
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .unboxing-eyebrow::before {
    content: "";
    width: 34px;
    height: 1px;
    background: currentColor;
  }

  .unboxing-copy h1 {
    margin: 0;
    color: #191817;
    font-size: clamp(62px, 5.3vw, 88px);
    font-weight: 660;
    line-height: 0.91;
    letter-spacing: -0.066em;
  }

  .unboxing-copy h1 em {
    color: #9b663d;
    font-style: normal;
    font-weight: inherit;
  }

  .unboxing-copy > p {
    max-width: 510px;
    margin: 28px 0 0;
    color: rgba(27, 25, 23, 0.68);
    font-size: clamp(17px, 1.25vw, 21px);
    line-height: 1.48;
    letter-spacing: -0.025em;
  }

  .unboxing-actions {
    align-items: center;
    justify-content: flex-start;
    margin-top: 33px;
  }

  .unboxing-primary {
    min-height: 48px;
    padding-inline: 24px;
    color: #fff;
    background: #1d1b19;
    box-shadow: 0 16px 34px rgba(48, 37, 26, 0.16);
  }

  .unboxing-primary:hover {
    color: #fff;
    background: #8f5c35;
    transform: translateY(-2px);
  }

  .unboxing-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    color: #352c25;
    font-size: 15px;
    font-weight: 600;
  }

  .unboxing-link span {
    transition: transform 180ms ease;
  }

  .unboxing-link:hover span {
    transform: translate(3px, -3px);
  }

  .unboxing-scene {
    --scene-rx: 0deg;
    --scene-ry: 0deg;
    --scene-x: 0px;
    --scene-y: 0px;
    position: absolute;
    z-index: 4;
    right: -3%;
    top: 50%;
    width: min(900px, 61vw);
    height: min(760px, 80vh);
    min-height: 640px;
    perspective: 1500px;
    transform-style: preserve-3d;
    transform: translate3d(var(--scene-x), calc(-50% + var(--scene-y) + var(--scene-scroll)), 0) rotateX(var(--scene-rx)) rotateY(var(--scene-ry));
    transition: transform 950ms cubic-bezier(0.2, 0.7, 0, 1);
    will-change: transform;
  }

  .unboxing-scene::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 5% -2% -1% 0;
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(ellipse at 58% 57%, rgba(203, 185, 163, 0.58) 0%, rgba(226, 216, 201, 0.4) 39%, rgba(239, 234, 226, 0.12) 63%, transparent 76%);
    filter: blur(20px);
    transform: scale(0.72);
    animation: unboxing-stage-glow 1.5s 380ms cubic-bezier(0.2, 0.75, 0, 1) forwards;
  }

  .unboxing-floor {
    position: absolute;
    z-index: 1;
    left: 11%;
    right: 4%;
    bottom: 2%;
    height: 25%;
    border-radius: 50%;
    opacity: 0;
    background: radial-gradient(ellipse, rgba(96, 73, 49, 0.24), rgba(124, 107, 89, 0.08) 42%, transparent 70%);
    filter: blur(14px);
    transform: rotateX(72deg) scale(0.6);
    animation: unboxing-floor-in 1.25s 650ms cubic-bezier(0.2, 0.75, 0, 1) forwards;
  }

  .unboxing-object {
    position: absolute;
    transform-style: preserve-3d;
    will-change: transform, opacity;
  }

  .unboxing-object > span {
    position: absolute;
    inset: 0;
    display: block;
    transform-style: preserve-3d;
  }

  .unboxing-object img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    user-select: none;
  }

  .unboxing-box {
    z-index: 3;
    left: 15%;
    bottom: 1%;
    width: 78%;
    aspect-ratio: 4 / 3;
    opacity: 0;
    filter: drop-shadow(0 34px 38px rgba(40, 28, 18, 0.26));
    transform: translate3d(0, 34%, -80px) rotateX(18deg) scale(0.72);
    animation: unboxing-box-in 1.5s 300ms cubic-bezier(0.18, 0.78, 0, 1) forwards;
  }

  .unboxing-box > span {
    transform: translate3d(0, 0, 0);
  }

  .unboxing-box img {
    object-fit: contain;
  }

  .unboxing-notebooks {
    z-index: 5;
    left: -1%;
    top: 3%;
    width: 58%;
    aspect-ratio: 4 / 3;
    opacity: 0;
    filter: drop-shadow(0 28px 30px rgba(64, 42, 25, 0.2));
    transform: translate3d(72%, 78%, -140px) rotate(-14deg) scale(0.32);
    animation: unboxing-notebook-in 1.55s 600ms cubic-bezier(0.16, 0.84, 0, 1) forwards;
  }

  .unboxing-notebooks > span {
    transform: translate3d(0, 0, 0);
  }

  .unboxing-notebooks img {
    object-fit: contain;
  }

  .unboxing-bottle {
    z-index: 8;
    right: 2%;
    top: 0;
    width: 31%;
    aspect-ratio: 0.78;
    overflow: hidden;
    opacity: 0;
    filter: drop-shadow(0 28px 27px rgba(70, 49, 32, 0.19));
    transform: translate3d(-118%, 82%, -100px) rotate(8deg) scale(0.28);
    animation: unboxing-bottle-in 1.5s 870ms cubic-bezier(0.16, 0.84, 0, 1) forwards;
  }

  .unboxing-bottle > span {
    inset: -8% -72%;
    transform: translate3d(0, 0, 0);
  }

  .unboxing-bottle img {
    object-position: center;
    object-fit: contain;
  }

  @keyframes unboxing-box-in {
    0% { opacity: 0; transform: translate3d(0, 34%, -80px) rotateX(18deg) scale(0.72); }
    55% { opacity: 1; }
    100% { opacity: 1; transform: translate3d(0, 0, 10px) rotateX(4deg) scale(1); }
  }

  @keyframes unboxing-notebook-in {
    0% { opacity: 0; transform: translate3d(72%, 78%, -140px) rotate(-14deg) scale(0.32); }
    100% { opacity: 1; transform: translate3d(0, 0, 80px) rotate(-7deg) scale(1); }
  }

  @keyframes unboxing-bottle-in {
    0% { opacity: 0; transform: translate3d(-118%, 82%, -100px) rotate(8deg) scale(0.28); }
    100% { opacity: 1; transform: translate3d(0, 0, 150px) rotate(5deg) scale(1); }
  }

  @keyframes unboxing-stage-glow {
    to { opacity: 1; transform: scale(1); }
  }

  @keyframes unboxing-floor-in {
    to { opacity: 1; transform: rotateX(72deg) scale(1); }
  }

  @keyframes unboxing-copy-in {
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes unboxing-horizon { to { opacity: 1; } }

  @media (max-width: 1120px) {
    .unboxing-copy {
      width: min(500px, 42vw);
    }

    .unboxing-copy h1 {
      font-size: clamp(57px, 5.6vw, 76px);
    }

    .unboxing-scene {
      right: -8%;
      width: 66vw;
    }
  }

  @media (max-width: 1100px) {
    .hero-unboxing {
      min-height: max(850px, calc(100svh - 98px));
    }

    .unboxing-shell {
      width: min(100% - 36px, 680px);
    }

    .unboxing-copy {
      top: 34px;
      width: 100%;
      text-align: center;
      transform: translate3d(0, var(--copy-scroll), 0);
    }

    .unboxing-eyebrow,
    .unboxing-actions {
      justify-content: center;
    }

    .unboxing-copy h1 {
      font-size: clamp(52px, 11vw, 72px);
    }

    .unboxing-copy > p {
      max-width: 570px;
      margin: 21px auto 0;
      font-size: 17px;
    }

    .unboxing-actions {
      margin-top: 24px;
    }

    .unboxing-scene {
      right: 50%;
      top: auto;
      bottom: -10px;
      width: min(720px, 108vw);
      height: 510px;
      min-height: 0;
      transform: translate3d(calc(50% + var(--scene-x)), calc(var(--scene-y) + var(--scene-scroll)), 0) rotateX(var(--scene-rx)) rotateY(var(--scene-ry));
    }

  }

  @media (max-width: 560px) {
    .hero-unboxing {
      min-height: max(740px, calc(100svh - 96px));
    }

    .unboxing-shell {
      width: calc(100% - 28px);
    }

    .unboxing-copy {
      top: 25px;
    }

    .unboxing-eyebrow {
      gap: 9px;
      margin-bottom: 14px;
      font-size: 9px;
      letter-spacing: 0.14em;
    }

    .unboxing-eyebrow::before {
      width: 22px;
    }

    .unboxing-copy h1 {
      font-size: clamp(45px, 13.3vw, 60px);
      line-height: 0.92;
    }

    .unboxing-copy > p {
      max-width: 390px;
      margin-top: 16px;
      font-size: 15px;
      line-height: 1.4;
    }

    .unboxing-actions {
      gap: 8px 16px;
      margin-top: 19px;
    }

    .unboxing-primary {
      min-height: 43px;
      padding-inline: 18px;
      font-size: 13px;
    }

    .unboxing-link {
      min-height: 39px;
      font-size: 13px;
    }

    .unboxing-scene {
      bottom: 0;
      width: 118vw;
      height: 430px;
    }

    .unboxing-notebooks {
      left: 3%;
      top: 5%;
      width: 51%;
    }

    .unboxing-bottle {
      right: 9%;
      top: 4%;
      width: 26%;
    }

    .unboxing-box {
      left: 16%;
      width: 69%;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .hero-unboxing *,
    .hero-unboxing *::before,
    .hero-unboxing *::after {
      animation-duration: 0.001ms !important;
      animation-delay: 0ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
    }

    .unboxing-scene {
      transition: none;
    }
  }
</style>
