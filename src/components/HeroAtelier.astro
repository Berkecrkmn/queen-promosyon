---
import { withBase } from "@utils/paths";

const atelierProducts = [
  {
    title: "İmza Defter",
    detail: "Termo deri · Sıcak yaldız",
    image: "/assets/images/queen-edit-defter-ajanda-queen.webp",
    alt: "Queen sıcak yaldız logolu deri defter ve kalem",
  },
  {
    title: "Executive Set",
    detail: "Özel kutu · Queen sunumu",
    image: "/assets/images/queen-edit-hediyelik-set-queen.webp",
    alt: "Queen logolu premium kurumsal hediye seti",
  },
  {
    title: "Writing Edit",
    detail: "Metal gövde · Lazer baskı",
    image: "/assets/images/queen-edit-kalem-seti-queen.webp",
    alt: "Queen logolu kutuda premium metal kalem seti",
  },
];
---

<section class="apple-hero hero-atelier" data-hero-atelier aria-labelledby="hero-title">
  <div class="hero-atelier-spectrum" aria-hidden="true"></div>
  <div class="hero-atelier-word" aria-hidden="true">QUEEN</div>

  <div class="hero-atelier-shell">
    <header class="hero-atelier-copy" data-reveal="copy">
      <span><i aria-hidden="true"></i> Queen Atelier / 01</span>
      <h1 id="hero-title">Markanız.<br /><em>sıraya girmez.</em></h1>
      <p>Seçtiğiniz ürünü katalogdan çıkarıp, markanızın imzasına dönüştürüyoruz.</p>
      <div class="apple-actions">
        <a class="apple-button apple-button-ink" href={withBase("/kategoriler")}>Koleksiyonu keşfedin</a>
        <a class="atelier-text-link" href={withBase("/teklif-al")}>Birlikte tasarlayalım <span aria-hidden="true">↗</span></a>
      </div>
      <div class="hero-atelier-proof" aria-hidden="true">
        <span>01 Seçim</span><i></i><span>02 Uygulama</span><i></i><span>03 Sunum</span>
      </div>
    </header>

    <div class="hero-atelier-stage" data-atelier-stage data-reveal="media">
      <div class="atelier-frame">
        <div class="atelier-frame-bar" aria-hidden="true">
          <span>QUEEN / MATERIAL LAB</span>
          <i></i>
          <small>TR · 2026</small>
        </div>

        <div class="atelier-deck" data-atelier-deck data-active="0" aria-label="Queen ürün seçkisi">
          {atelierProducts.map((product, index) => (
            <button
              class:list={["atelier-slice", { "is-active": index === 0 }]}
              type="button"
              data-atelier-slice={index}
              aria-pressed={index === 0 ? "true" : "false"}
              aria-label={`${product.title}: ${product.detail}`}
            >
              <img src={withBase(product.image)} alt={product.alt} loading={index === 0 ? "eager" : "lazy"} width="1440" height="1080" />
              <span class="atelier-slice-number" aria-hidden="true">0{index + 1}</span>
              <span class="atelier-slice-copy">
                <strong>{product.title}</strong>
                <small>{product.detail}</small>
              </span>
            </button>
          ))}
        </div>

        <div class="atelier-mark" aria-hidden="true">
          <span>Curated by</span>
          <img src={withBase("/assets/brand/queen-logo-transparent.png")} alt="" width="868" height="751" />
        </div>
      </div>

      <p class="atelier-stage-note" aria-hidden="true"><span>Üç seçki.</span> Tek bir Queen standardı.</p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-hero-atelier]").forEach((section) => {
    const stage = section.querySelector<HTMLElement>("[data-atelier-stage]");
    const deck = section.querySelector<HTMLElement>("[data-atelier-deck]");
    const slices = Array.from(section.querySelectorAll<HTMLButtonElement>("[data-atelier-slice]"));
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const precisePointer = window.matchMedia("(pointer: fine)").matches;

    const selectSlice = (slice: HTMLButtonElement) => {
      const index = slice.dataset.atelierSlice ?? "0";
      deck?.setAttribute("data-active", index);
      slices.forEach((item) => {
        const active = item === slice;
        item.classList.toggle("is-active", active);
        item.setAttribute("aria-pressed", String(active));
      });
    };

    slices.forEach((slice) => {
      slice.addEventListener("pointerenter", () => selectSlice(slice));
      slice.addEventListener("focus", () => selectSlice(slice));
      slice.addEventListener("click", () => selectSlice(slice));
    });

    if (!stage || reduceMotion || !precisePointer) return;
    let frame = 0;
    section.addEventListener("pointermove", (event) => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        const rect = section.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - 0.5;
        const y = (event.clientY - rect.top) / rect.height - 0.5;
        stage.style.setProperty("--atelier-x", `${(x * 8).toFixed(2)}px`);
        stage.style.setProperty("--atelier-y", `${(y * 7).toFixed(2)}px`);
        stage.style.setProperty("--atelier-rx", `${(-y * 2.2).toFixed(2)}deg`);
        stage.style.setProperty("--atelier-ry", `${(x * 2.8).toFixed(2)}deg`);
      });
    });

    section.addEventListener("pointerleave", () => {
      stage.style.setProperty("--atelier-x", "0px");
      stage.style.setProperty("--atelier-y", "0px");
      stage.style.setProperty("--atelier-rx", "0deg");
      stage.style.setProperty("--atelier-ry", "0deg");
    });
  });
</script>
