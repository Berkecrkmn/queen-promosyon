---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";

type Props = {
  title: string;
  description: string;
  canonical: string;
  eyebrow?: string;
  intro: string;
  updated?: string;
};

const {
  title,
  description,
  canonical,
  eyebrow = "Yasal",
  intro,
  updated = "10 Temmuz 2026",
} = Astro.props;
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <section class="legal-hero">
    <Breadcrumbs items={[{ label: title }]} />
    <div data-reveal>
      <span class="eyebrow">{eyebrow}</span>
      <h1>{title}</h1>
      <p>{intro}</p>
      <small>Son güncelleme: {updated}</small>
    </div>
  </section>
  <article class="legal-document" data-reveal>
    <slot />
  </article>
</BaseLayout>
